<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="WarpSearch_Search::css/quick-search.css"/>
    </head>
    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="warpsearch.quick.search"
                   template="WarpSearch_Search::quick-search.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">WarpSearch\Search\ViewModel\QuickSearch</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
